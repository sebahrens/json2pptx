{
  "_skeleton": "exec-summary",
  "_description": "Executive briefing: 6 slides. Lead with the headline number, then evidence, decision, and ask. Rhythm: title, hero metric, supporting KPIs, comparison/decision, validation, closing.",
  "_instructions": "Replace every __FILL_*__ token with content. Do not introduce new patterns or layouts without re-running analyze_deck_rhythm. Delete this and the _* keys before validating.",
  "template": "__FILL_TEMPLATE_NAME__ (one of: midnight-blue, forest-green, modern-template, warm-coral)",
  "design_mode": "constrained",
  "accent_strategy": "rotate",
  "output_filename": "__FILL_OUTPUT_FILENAME__.pptx",
  "slides": [
    {
      "layout_id": "title",
      "contrast_check": true,
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "__FILL_DECK_TITLE__"},
        {"placeholder_id": "subtitle", "type": "text", "text_value": "__FILL_DECK_SUBTITLE__ (audience + period, e.g. 'Board update — Q2 2026')"}
      ]
    },
    {
      "layout_id": "blank",
      "contrast_check": true,
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "__FILL_HERO_SLIDE_TITLE__ (the one-line story, e.g. 'Revenue grew 34% on enterprise traction')"}
      ],
      "pattern": {
        "name": "stat-hero",
        "values": {
          "value": "__FILL_HERO_STAT__ (e.g. '$12.6M')",
          "label": "__FILL_HERO_LABEL__ (one sentence — what the number means)",
          "context": "__FILL_HERO_CONTEXT__ (optional driver / source, one line)"
        }
      }
    },
    {
      "layout_id": "blank",
      "contrast_check": true,
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "__FILL_KPI_SLIDE_TITLE__ (e.g. 'Supporting metrics')"}
      ],
      "pattern": {
        "name": "kpi-3up",
        "values": [
          {"big": "__FILL_KPI1_BIG__", "small": "__FILL_KPI1_SMALL__"},
          {"big": "__FILL_KPI2_BIG__", "small": "__FILL_KPI2_SMALL__"},
          {"big": "__FILL_KPI3_BIG__", "small": "__FILL_KPI3_SMALL__"}
        ]
      }
    },
    {
      "layout_id": "blank",
      "contrast_check": true,
      "takeaway": "__FILL_MATRIX_TAKEAWAY__ (one sentence — the headline reading of the 2x2)",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "__FILL_MATRIX_TITLE__ (e.g. 'Strategic priorities')"}
      ],
      "pattern": {
        "name": "matrix-2x2",
        "values": {
          "x_axis_label": "__FILL_X_AXIS__ (e.g. 'Effort')",
          "y_axis_label": "__FILL_Y_AXIS__ (e.g. 'Impact')",
          "top_left": {"header": "__FILL_TL_HEADER__", "body": "__FILL_TL_BODY__"},
          "top_right": {"header": "__FILL_TR_HEADER__", "body": "__FILL_TR_BODY__"},
          "bottom_left": {"header": "__FILL_BL_HEADER__", "body": "__FILL_BL_BODY__"},
          "bottom_right": {"header": "__FILL_BR_HEADER__", "body": "__FILL_BR_BODY__"}
        }
      }
    },
    {
      "layout_id": "blank",
      "contrast_check": true,
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "__FILL_QUOTE_TITLE__ (e.g. 'Customer voice' or 'Why this matters')"}
      ],
      "pattern": {
        "name": "pull-quote",
        "values": {
          "quote": "__FILL_QUOTE__ (one or two sentences max — a real customer / partner voice)",
          "attribution": "__FILL_ATTRIBUTION_NAME__",
          "role": "__FILL_ATTRIBUTION_ROLE__"
        }
      }
    },
    {
      "layout_id": "closing",
      "contrast_check": true,
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "__FILL_CLOSING_TITLE__ (e.g. 'Next steps' or 'The ask')"},
        {"placeholder_id": "subtitle", "type": "text", "text_value": "__FILL_CLOSING_SUBTITLE__ (1-2 specific actions or owners)"}
      ]
    }
  ]
}
