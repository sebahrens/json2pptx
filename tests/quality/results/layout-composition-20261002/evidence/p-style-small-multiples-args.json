{
  "spec": {
    "meta": {
      "template": "p-style",
      "title": "Small-multiple scale control",
      "source": "Illustrative comparison data"
    },
    "slides": [
      {
        "kind": "raw_json2pptx",
        "slide": {
          "layout_id": "blank-title",
          "content": [
            {
              "placeholder_id": "title",
              "type": "text",
              "text_value": "Region B has ten times the revenue of Region A"
