          ],
          "compose": {
            "direction": "horizontal",
            "segments": [
              {
                "size_pct": 50,
                "diagram": {
                  "type": "line_chart",
                  "title": "Region A revenue (\u20acm)",
                  "alt": "Region A revenue over four quarters",
                  "data": {
                    "categories": [
                      "Q1",
                      "Q2",
                      "Q3",
                      "Q4"
                    ],
                    "series": [
                      {
                        "name": "Region A",
                        "values": [
                          10,
                          20,
                          15,
                          25
                        ]
                      }
                    ],
                    "data_labels": false
                  }
                }
              },
              {
                "size_pct": 50,
                "diagram": {
                  "type": "line_chart",
                  "title": "Region B revenue (\u20acm)",
                  "alt": "Region B revenue over four quarters",
                  "data": {
                    "categories": [
                      "Q1",
                      "Q2",
                      "Q3",
                      "Q4"
                    ],
                    "series": [
                      {
                        "name": "Region B",
                        "values": [
                          100,
                          200,
                          150,
                          250
                        ]
                      }
                    ],
                    "data_labels": false
                  }
                }
              }
            ]
          }
        }
      }
    ]
  }
}