{
  "template": "midnight-blue",
  "output_filename": "patterns-smoke.pptx",
  "slides": [
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "KPI 3-Up"}
      ],
      "pattern": {
        "name": "kpi-3up",
        "values": [
          {"big": "$4.2M", "small": "Annual Revenue"},
          {"big": "98.7%", "small": "Uptime SLA"},
          {"big": "1,247", "small": "Active Users"}
        ]
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "KPI 4-Up"}
      ],
      "pattern": {
        "name": "kpi-4up",
        "values": [
          {"big": "$4.2M", "small": "ARR"},
          {"big": "87%", "small": "NPS Score"},
          {"big": "1.2K", "small": "MAU"},
          {"big": "42", "small": "Open Deals"}
        ],
        "overrides": {"accent": "accent2"}
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Business Model Canvas"}
      ],
      "pattern": {
        "name": "bmc-canvas",
        "values": {
          "key_partners": {"header": "Key Partners", "bullets": ["Cloud providers", "Payment processors"]},
          "key_activities": {"header": "Key Activities", "bullets": ["Platform development", "Customer support"]},
          "key_resources": {"header": "Key Resources", "bullets": ["Engineering team", "IP portfolio"]},
          "value_propositions": {"header": "Value Propositions", "bullets": ["Faster time-to-market", "Lower TCO"]},
          "customer_relations": {"header": "Customer Relations", "bullets": ["Dedicated CSM", "Self-service portal"]},
          "channels": {"header": "Channels", "bullets": ["Direct sales", "Partner network"]},
          "customer_segments": {"header": "Customer Segments", "bullets": ["Enterprise SaaS", "Mid-market"]},
          "cost_structure": {"header": "Cost Structure", "bullets": ["Infrastructure", "R&D headcount"]},
          "revenue_streams": {"header": "Revenue Streams", "bullets": ["Subscriptions", "Professional services"]}
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Priority Matrix"}
      ],
      "pattern": {
        "name": "matrix-2x2",
        "values": {
          "x_axis_label": "Effort",
          "y_axis_label": "Impact",
          "top_left": {"header": "Quick Wins", "body": "High impact, low effort"},
          "top_right": {"header": "Major Projects", "body": "High impact, high effort"},
          "bottom_left": {"header": "Fill-Ins", "body": "Low impact, low effort"},
          "bottom_right": {"header": "Thankless Tasks", "body": "Low impact, high effort"}
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Product Roadmap"}
      ],
      "pattern": {
        "name": "timeline-horizontal",
        "values": [
          {"label": "Q1 2026", "date": "Jan-Mar", "body": "Foundation & core APIs"},
          {"label": "Q2 2026", "date": "Apr-Jun", "body": "Beta launch"},
          {"label": "Q3 2026", "date": "Jul-Sep", "body": "GA release"},
          {"label": "Q4 2026", "date": "Oct-Dec", "body": "Enterprise features"},
          {"label": "Q1 2027", "date": "Jan-Mar", "body": "International expansion"}
        ]
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Service Tiers"}
      ],
      "pattern": {
        "name": "card-grid",
        "values": {
          "columns": 3,
          "rows": 2,
          "cells": [
            {"header": "Starter", "body": "For individuals and small teams getting started"},
            {"header": "Professional", "body": "For growing teams that need more power"},
            {"header": "Enterprise", "body": "For large organizations with custom needs"},
            {"header": "API Access", "body": "Programmatic access to all platform features"},
            {"header": "Analytics", "body": "Advanced reporting and business intelligence"},
            {"header": "Support", "body": "24/7 dedicated support and SLA guarantees"}
          ]
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Service Tiers (with cell_overrides)"}
      ],
      "pattern": {
        "name": "card-grid",
        "values": {
          "columns": 3,
          "rows": 1,
          "cells": [
            {"header": "Starter", "body": "For individuals"},
            {"header": "Professional", "body": "For growing teams"},
            {"header": "Enterprise", "body": "For large organizations"}
          ]
        },
        "cell_overrides": {
          "1": {"accent_bar": true, "emphasis": "bold", "align": "center"},
          "2": {"color": "accent2", "font_size": 11, "vertical_align": "middle"}
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Our Values"}
      ],
      "pattern": {
        "name": "icon-row",
        "values": [
          {"icon": "star", "caption": "Excellence"},
          {"icon": "users", "caption": "Collaboration"},
          {"icon": "rocket", "caption": "Innovation"},
          {"icon": "heart", "caption": "Customer Love"}
        ]
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Before vs After"}
      ],
      "pattern": {
        "name": "comparison-2col",
        "values": {
          "header_left": "Before",
          "header_right": "After",
          "rows": [
            {"left": "Manual deployments", "right": "Automated CI/CD pipeline"},
            {"left": "4-hour release cycles", "right": "15-minute deployments"},
            {"left": "Monolithic architecture", "right": "Microservices with clear boundaries"},
            {"left": "Reactive monitoring", "right": "Proactive observability"}
          ]
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Modernization Roadmap"}
      ],
      "pattern": {
        "name": "phase-roadmap",
        "values": {
          "phases": [
            {"name": "Plan", "date_label": "Mar–Apr 2025", "description": "Define scope, governance, stakeholders."},
            {"name": "Build", "date_label": "May–Jul 2025", "description": "Implement core capabilities and run pilot.", "active": true, "milestone": "Pilot go-live"},
            {"name": "Scale", "date_label": "Aug–Oct 2025", "description": "Roll out to remaining business units."},
            {"name": "Optimize", "date_label": "Nov–Dec 2025", "description": "Tune cost, capture lessons, hand to BAU."}
          ]
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Quarterly Revenue Trajectory"}
      ],
      "pattern": {
        "name": "chart-insights-split",
        "values": {
          "chart": {
            "type": "bar_chart",
            "data": {
              "categories": ["Q1", "Q2", "Q3", "Q4"],
              "series": [
                {"name": "Revenue ($M)", "values": [4.2, 5.1, 6.3, 8.1]}
              ]
            }
          },
          "insights_title": "Key Insights",
          "insights": [
            "Revenue grew 93% YoY driven by enterprise expansion.",
            "Q4 spike reflects the EMEA market launch.",
            "Pipeline coverage signals continued acceleration in FY26."
          ],
          "source": "Source: Internal finance (FY25)"
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "FY26 Strategy: Executive Summary"}
      ],
      "pattern": {
        "name": "scqa-summary",
        "values": {
          "situation": "Cloud spend grew 38% YoY across the portfolio in FY25.",
          "complication": [
            "Unit economics flattened as workloads scaled, eroding gross margin.",
            "Finance projects an additional 22% increase if usage trends hold."
          ],
          "questions": [
            "Which workloads drive disproportionate spend?",
            "Where can we reclaim margin without slowing the roadmap?"
          ],
          "answer": [
            "Right-size the top 10 workloads to recover 14% of FY26 spend.",
            "Stand up a FinOps council with monthly accountability reviews."
          ]
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Industrial Value Chain"}
      ],
      "pattern": {
        "name": "value-chain",
        "values": {
          "steps": [
            {"label": "Extraction", "description": "Mining raw materials and managing EPC contracts."},
            {"label": "Processing", "description": "Refining ore into intermediate inputs."},
            {"label": "Manufacturing", "description": "Converting inputs into finished goods.", "highlight": true},
            {"label": "Distribution", "description": "Moving product through wholesale channels."},
            {"label": "Retail", "description": "Reaching end customers via partner stores."},
            {"label": "Service", "description": "Supporting customers through the product lifecycle."}
          ]
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Today's Agenda"}
      ],
      "pattern": {
        "name": "agenda-with-images",
        "values": {
          "items": [
            {"title": "Executive Summary", "subtitle": "Situation, complication and our answer", "image_label": "Chart: Revenue trend"},
            {"title": "Market Analysis", "subtitle": "Size, growth and competitive position", "image_label": "Photo: Market scene"},
            {"title": "Strategic Options", "subtitle": "Three paths and our recommendation", "image_label": "Diagram: Option tree"},
            {"title": "Implementation Plan", "subtitle": "Phased rollout over 12 months", "image_label": "Photo: Project team"},
            {"title": "Next Steps", "subtitle": "Decisions required from this meeting"}
          ]
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Our Engagement Team"}
      ],
      "pattern": {
        "name": "team-bios",
        "values": {
          "members": [
            {"name": "Jane Smith", "role": "Project Lead", "bio": "10 years in supply-chain strategy. Previously at McKinsey."},
            {"name": "Arun Patel", "role": "Lead Engineer", "bio": "Built data platforms at two scale-ups. MIT alumnus."},
            {"name": "Lila Romero", "role": "Design Lead", "bio": "Service-design specialist. Ex-IDEO, ex-Frog."},
            {"name": "Tom Becker", "role": "Client Partner", "bio": "Account director for top-10 retailers. Frankfurt office."}
          ]
        }
      }
    },
    {
      "layout_id": "slideLayout2",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "What stakeholders are telling us"}
      ],
      "pattern": {
        "name": "quote-cluster",
        "values": {
          "quotes": [
            {"text": "The new platform cut our cycle time in half.", "name": "J. Lin", "title": "Head of Operations"},
            {"text": "Our analysts finally trust the numbers they see.", "name": "P. Reyes", "title": "Director of Finance"},
            {"text": "Adoption was easier than any tool we have rolled out.", "name": "K. Müller", "title": "CTO"},
            {"text": "We are catching issues weeks earlier than before.", "name": "S. Patel", "title": "VP Customer Success"},
            {"text": "Reporting that used to take days is now a click.", "name": "M. Tanaka", "title": "Regional Controller"},
            {"text": "The team's data fluency has stepped up across the board.", "name": "A. Okafor", "title": "Chief Data Officer"}
          ]
        }
      }
    }
  ]
}
