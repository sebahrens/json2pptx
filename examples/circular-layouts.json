            "size_pct": 50,
            "pattern": {
              "name": "labeled-rows",
              "values": {
                "rows": [
                  {"label": "WHO", "body": "One funding owner per portfolio, not a committee"},
                  {"label": "WHAT", "body": "Pre-agreed envelopes released at the decision meeting"},
                  {"label": "HOW", "body": "Exceptions only above 2M go to the board"}
                ]
              }
            }
          }
        ]
      }
    },
