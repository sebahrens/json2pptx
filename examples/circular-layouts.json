        "name": "cycle-nodes",
        "values": {
          "highlight": 3,
          "steps": [
            {"label": "Pick one loss", "description": "Largest gap on the loss tree"},
            {"label": "Trial the fix", "description": "One line, two shifts, one owner"},
            {"label": "Measure the gap", "description": "Same metric before and after"},
            {"label": "Set the standard", "description": "Update the work instruction"},
            {"label": "Share it", "description": "Brief the sister plants in a week"}
