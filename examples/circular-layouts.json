{
  "template": "midnight-blue",
  "chrome": {
    "confidentiality": "Confidential",
    "page_numbers": {
      "enabled": true,
      "format": "{current}"
    }
  },
  "output_filename": "circular-layouts.pptx",
  "slides": [
    {
      "layout_id": "title",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Operating Model Review: Loops, Hubs and Layers"},
        {"placeholder_id": "subtitle", "type": "text", "text_value": "The circular layout family, alone and in split layouts"}
      ]
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Four loops run the business; each has one step that sets its pace"}
      ],
      "pattern": {
        "name": "exec-summary",
        "values": {
          "points": [
            {"lead": "Planning stalls at funding.", "support": "Releasing money takes three weeks of a two-month cycle."},
            {"lead": "Plants learn in six-week loops.", "support": "Those that close each loop recover twice the capacity."},
            {"lead": "Renewal is won by month nine.", "support": "The account loop decides it long before the contract date."},
            {"lead": "One customer record replaces six.", "support": "Connecting risk first removes most duplicates."}
          ]
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "The planning cycle turns six times a year and stalls at the funding decision"}
      ],
      "pattern": {
        "name": "cycle-ring",
        "values": {
          "center": {"label": "Two-month cycle"},
          "phases": [
            {"label": "Forecast", "description": "Rolling 18-month demand view"},
            {"label": "Review results", "description": "Variance against the last plan"},
            {"label": "Decide", "description": "Trade-offs settled in one meeting"},
            {"label": "Commit funding", "description": "Release takes three weeks today", "highlight": true},
            {"label": "Execute", "description": "Teams work to a frozen scope"},
            {"label": "Track benefits", "description": "Owners report against the case"}
          ]
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Three changes take the funding decision from three weeks to five days"}
      ],
      "compose": {
        "direction": "horizontal",
        "segments": [
          {
            "size_pct": 50,
            "pattern": {
              "name": "cycle-ring",
              "values": {
                "phases": [
                  {"label": "Forecast"},
                  {"label": "Review results"},
                  {"label": "Decide"},
                  {"label": "Commit funding", "highlight": true},
                  {"label": "Execute"},
                  {"label": "Track benefits"}
