{
  "template": "midnight-blue",
  "chrome": {
    "confidentiality": "Confidential",
    "page_numbers": {
      "enabled": true,
      "format": "{current}"
    }
  },
  "output_filename": "capability-heatmap.pptx",
  "accent_strategy": "primary",
  "slides": [
    {
      "layout_id": "title",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Automation Potential by Function"},
        {"placeholder_id": "subtitle", "type": "text", "text_value": "Capability heatmaps: activities rated by tier under each function"}
      ]
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Middle office and operations hold the largest AI capacity unlock"}
      ],
      "pattern": {
        "name": "capability-heatmap",
        "values": {
          "tiers": [
            {"label": "High", "description": ">50% of time automatable"},
            {"label": "Medium", "description": "20-50% of time automatable"},
            {"label": "Low", "description": "<20% of time automatable"}
          ],
          "columns": [
            {"header": "Front office", "sublabel": "Up to 30% unlock", "cells": [
              {"text": "Research summaries", "tier": 0},
              {"text": "Pitch books", "tier": 0},
              {"text": "RFP responses", "tier": 1}
            ]},
            {"header": "Middle office", "sublabel": "Up to 45% unlock", "cells": [
              {"text": "Reconciliations", "tier": 0},
              {"text": "Risk reporting", "tier": 0},
              {"text": "Limit monitoring", "tier": 1}
            ]},
            {"header": "Operations", "sublabel": "Up to 40% unlock", "cells": [
              {"text": "Trade settlement", "tier": 0},
              {"text": "Corporate actions", "tier": 1},
              {"text": "Client onboarding", "tier": 1}
            ]},
            {"header": "Corporate", "sublabel": "Up to 25% unlock", "cells": [
              {"text": "Invoicing", "tier": 0},
              {"text": "HR queries", "tier": 1},
              {"text": "FP&A", "tier": 2}
            ]},
            {"header": "Technology", "sublabel": "Up to 35% unlock", "cells": [
              {"text": "Code generation", "tier": 0},
              {"text": "Testing", "tier": 0},
              {"text": "Incident triage", "tier": 1}
            ]}
          ]
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Eight functions on a four-level scale, rectangular headers"}
      ],
      "pattern": {
        "name": "capability-heatmap",
        "values": {
          "tiers": [
            {"label": "Transform", "description": "Redesign end to end"},
            {"label": "Augment", "description": "AI copilots in the loop"},
            {"label": "Assist", "description": "Point tools"},
            {"label": "Retain", "description": "Human-led"}
          ],
          "columns": [
            {"header": "Sales", "cells": [{"text": "Scoring", "tier": 0}, {"text": "Bids", "tier": 1}, {"text": "Deals", "tier": 3}]},
            {"header": "Marketing", "cells": [{"text": "Content", "tier": 0}, {"text": "Analytics", "tier": 1}]},
            {"header": "Service", "cells": [{"text": "Chat", "tier": 0}, {"text": "Routing", "tier": 0}, {"text": "Escalate", "tier": 2}]},
            {"header": "Finance", "cells": [{"text": "Close", "tier": 1}, {"text": "Forecast", "tier": 1}, {"text": "Audit", "tier": 2}]},
            {"header": "HR", "cells": [{"text": "Hiring", "tier": 1}, {"text": "Onboard", "tier": 2}]},
            {"header": "Legal", "cells": [{"text": "Contracts", "tier": 1}, {"text": "Disputes", "tier": 3}]},
            {"header": "IT", "cells": [{"text": "Tickets", "tier": 0}, {"text": "Reviews", "tier": 1}, {"text": "Security", "tier": 2}]},
            {"header": "Supply", "cells": [{"text": "Demand", "tier": 0}, {"text": "Suppliers", "tier": 1}, {"text": "Freight", "tier": 2}]}
          ]
        },
        "overrides": {"header_shape": "rect", "accent": "accent2"}
