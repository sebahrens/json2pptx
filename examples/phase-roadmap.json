{
  "template": "midnight-blue",
  "output_filename": "phase-roadmap.pptx",
  "accent_strategy": "primary",
  "slides": [
    {
      "layout_id": "title",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Cloud Migration Programme"},
        {"placeholder_id": "subtitle", "type": "text", "text_value": "Four phases, single track, with key milestones"}
      ]
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Programme Roadmap (4 phases, active = Build)"}
      ],
      "pattern": {
        "name": "phase-roadmap",
        "values": {
          "phases": [
            {
              "name": "Plan",
              "date_label": "Mar–Apr 2025",
              "description": "Define scope and align stakeholders."
            },
            {
              "name": "Build",
              "date_label": "May–Jul 2025",
              "description": "Build core capabilities; run the pilot.",
              "active": true,
              "milestone": "Pilot go-live"
            },
            {
              "name": "Scale",
              "date_label": "Aug–Oct 2025",
              "description": "Roll out to remaining business units.",
              "milestone": "$2M savings target"
            },
            {
              "name": "Optimize",
              "date_label": "Nov–Dec 2025",
              "description": "Tune cost and hand over to operations."
            }
          ]
        },
        "callout": {
          "text": "Programme target: 18 % run-rate reduction by year-end.",
          "emphasis": "bold"
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Minimal 3-phase form (no milestones)"}
      ],
      "pattern": {
        "name": "phase-roadmap",
        "values": {
          "phases": [
            {"name": "Discovery", "date_label": "Q1", "description": "Stakeholder interviews and current-state mapping."},
            {"name": "Design", "date_label": "Q2", "description": "Target-state architecture and transition plan."},
            {"name": "Delivery", "date_label": "Q3–Q4", "description": "Wave-based execution against backlog."}
          ]
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Max 6-phase form with accent override"}
      ],
      "pattern": {
        "name": "phase-roadmap",
        "values": {
          "phases": [
            {"name": "Assess", "date_label": "Jan"},
            {"name": "Plan", "date_label": "Feb"},
            {"name": "Build", "date_label": "Mar"},
            {"name": "Pilot", "date_label": "Apr", "active": true},
            {"name": "Scale", "date_label": "May–Jun"},
            {"name": "Sustain", "date_label": "Jul+"}
          ]
        },
        "overrides": {
          "accent": "accent2"
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "A 12-month path from opportunity to enterprise-scale deployment"}
      ],
      "pattern": {
        "name": "phase-roadmap",
        "values": {
          "phases": [
            {"name": "Prioritized opportunity", "date_label": "Weeks 1–8", "description": "Pick workflows and size the P&L."},
            {"name": "Lighthouse builds", "date_label": "Months 3–6", "description": "Reimagine 2–3 workflows end to end.", "active": true, "milestone": "First lighthouse live"},
            {"name": "Wave 1 scale-up", "date_label": "Months 6–12", "description": "Expand across units and upskill."},
            {"name": "Continuous expansion", "date_label": "12 months+", "description": "Move toward an AI-native model."}
          ],
          "parallel_tracks": [
            "AI activation, change management, talent, and upskilling"
          ]
        }
      }
    }
  ]
}
