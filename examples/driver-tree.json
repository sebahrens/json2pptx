      "pattern": {
        "name": "driver-tree",
        "values": {
          "root": {"label": "Total Cost to Serve", "unit": "($/order)"},
          "branches": [
            {
              "label": "Fulfilment",
              "leaves": ["Pick & pack", "Outbound freight"]
