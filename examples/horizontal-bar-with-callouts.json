{
  "source": "Illustrative figures",
  "template": "midnight-blue",
  "chrome": {
    "confidentiality": "Confidential",
    "page_numbers": {
      "enabled": true,
      "format": "{current}"
    }
  },
  "output_filename": "horizontal-bar-with-callouts.pptx",
  "accent_strategy": "primary",
  "slides": [
    {
      "layout_id": "title",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Vendor Scorecard"},
        {"placeholder_id": "subtitle", "type": "text", "text_value": "Ranked horizontal bars with per-bar insight callouts"}
      ]
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Vendor A leads the evaluation at 87 points, 15 ahead of Vendor B"}
      ],
      "pattern": {
        "name": "horizontal-bar-with-callouts",
        "values": {
          "max_value": 100,
          "unit": "%",
          "bars": [
            {"label": "Vendor A", "value": 87, "callout": "Best price; weakest support SLA."},
            {"label": "Vendor B", "value": 72, "callout": "Enterprise pick; slow to implement."},
            {"label": "Vendor C", "value": 64, "callout": "Best APIs; mid-market focus."},
            {"label": "Vendor D", "value": 51, "callout": "Solid base; thin on security."},
            {"label": "Vendor E", "value": 33, "callout": "New entrant; track quarterly."}
          ]
        },
        "callout": {
          "text": "Vendor A and B advance to the BAFO round.",
          "emphasis": "bold"
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Enterprise is the largest opportunity at $42M, but the slowest to close"}
      ],
      "pattern": {
        "name": "horizontal-bar-with-callouts",
        "values": {
          "unit": "M",
          "bars": [
            {"label": "Enterprise", "value": 42, "callout": "Largest opportunity; 18-month sales cycle."},
            {"label": "Mid-market", "value": 27, "callout": "Fastest velocity; channel partner play."},
            {"label": "SMB", "value": 11, "callout": "Self-serve motion; low ACV but volume-driven."}
          ]
        }
      }
    },
    {
      "layout_id": "content",
      "content": [
        {"placeholder_id": "title", "type": "text", "text_value": "Pricing and cross-sell are the two biggest of eight growth levers"}
      ],
      "pattern": {
        "name": "horizontal-bar-with-callouts",
        "values": {
          "max_value": 100,
          "unit": "%",
          "bars": [
            {"label": "Pricing", "value": 92, "callout": "Largest contributor; revisit yearly."},
            {"label": "Cross-sell", "value": 81, "callout": "Drives ARR expansion in install base."},
            {"label": "New logo", "value": 73, "callout": "Pipeline coverage up 1.5x YoY."},
            {"label": "Renewals", "value": 64, "callout": "NRR floor; protect with CS investment."},
            {"label": "Geography", "value": 52, "callout": "EMEA launch closes regional gap."},
            {"label": "Channel", "value": 41, "callout": "Tier-1 partner motion in scoping."},
            {"label": "Product", "value": 33, "callout": "Three GAs gated on Q3 stability."},
            {"label": "Partnerships", "value": 22, "callout": "Strategic integrations; long lead time."}
          ]
        },
        "overrides": {
          "accent": "accent3"
        }
      }
    }
  ]
}
